# Copy to .env locally, or set on Cloud Run / Netlify.
# Neither is required; without them the app runs on its embedded
# snapshot and says so per-source in the Sources tab.

# https://datamall.lta.gov.sg  (free, emailed after registration)
LTA_ACCOUNT_KEY=

# Optional: enables the LLM intent parser. A rule-based parser
# produces the same constraint object without it.
ANTHROPIC_API_KEY=
